  "system": {
    "construct": "Full-length SARS-CoV-2 spike glycoprotein homotrimer, residues 16-1273 per chain (chains A, B, C; segments S1 16-685, S2 686-1273), in the open state (chain A RBD 'up') bearing the N165A and N234A substitutions. Non-canonical residues: HSD/HSE neutral histidines, CYP palmitoylated cysteine. Shared trajectories hold protein + glycans only and are not aligned; water, ions and the POPC/POPS/POPI/POPE/CHL bilayer were stripped.",
    "starting_structure": "PDB 6VSB (chain A RBD 'up'), with N165A and N234A substitutions",
    "glycan_profile": "60 N-glycans (20 per chain: G6/G7, G30/G31 and G53/G54 removed with the N165A and N234A substitutions) and 4 O-glycans (G23, G24 chain A; G47 chain B; G70 chain C), all on glycan chain G. Residues used: BGLN, AGAN, BGAL, BMAN, AMAN, AFUC, ANE5.",
    "total_atoms": 71294
  },
